{
	"name": "PL_SOURCE_TO_SILVER_INNER",
	"properties": {
		"activities": [
			{
				"name": "Read Tables Details",
				"type": "Lookup",
				"dependsOn": [],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "AzureSqlSource",
						"sqlReaderQuery": {
							"value": "SELECT * FROM ctrl.table_config WHERE table_id = @{pipeline().parameters.table_id}",
							"type": "Expression"
						},
						"queryTimeout": "02:00:00",
						"partitionOption": "None"
					},
					"dataset": {
						"referenceName": "AzureSqlTable1",
						"type": "DatasetReference"
					},
					"firstRowOnly": true
				}
			},
			{
				"name": "Set Start Time",
				"type": "SetVariable",
				"dependsOn": [],
				"policy": {
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"variableName": "start time",
					"value": {
						"value": "@formatDateTime(utcNow(),'yyyy-MM-dd_hh:mm:ss')",
						"type": "Expression"
					}
				}
			},
			{
				"name": "Landing to Bronze",
				"type": "DatabricksNotebook",
				"dependsOn": [
					{
						"activity": "Check Source System",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"notebookPath": "/OneCare-repo/OneCare_ADB_repo/Landing to Bronze",
					"baseParameters": {
						"source_system": {
							"value": "@activity('Read Tables Details').output.firstRow.source_system",
							"type": "Expression"
						},
						"table_name": {
							"value": "@activity('Read Tables Details').output.firstRow.bronze_table_name",
							"type": "Expression"
						},
						"landing_timestamp": {
							"value": "@variables('start time')",
							"type": "Expression"
						},
						"source_file_format": {
							"value": "@coalesce(activity('Read Tables Details').output.firstRow.source_file_format,'')",
							"type": "Expression"
						}
					}
				},
				"linkedServiceName": {
					"referenceName": "LS_AzureDatabricks",
					"type": "LinkedServiceReference"
				}
			},
			{
				"name": "Bronze to Silver",
				"type": "DatabricksNotebook",
				"dependsOn": [
					{
						"activity": "Landing to Bronze",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"notebookPath": "/OneCare-repo/OneCare_ADB_repo/bronze to silver",
					"baseParameters": {
						"table_name": {
							"value": "@activity('Read Tables Details').output.firstRow.silver_table_name",
							"type": "Expression"
						},
						"landing_timestamp": {
							"value": "@variables('start time')",
							"type": "Expression"
						},
						"load_type": {
							"value": "@activity('Read Tables Details').output.firstRow.load_type",
							"type": "Expression"
						},
						"merge_keys": {
							"value": "@coalesce(activity('Read Tables Details').output.firstRow.merge_keys,'')",
							"type": "Expression"
						}
					}
				},
				"linkedServiceName": {
					"referenceName": "LS_AzureDatabricks",
					"type": "LinkedServiceReference"
				}
			},
			{
				"name": "Update Success Status",
				"type": "Script",
				"dependsOn": [
					{
						"activity": "Bronze to Silver",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 2,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"linkedServiceName": {
					"referenceName": "LS_AzureSqlDatabase",
					"type": "LinkedServiceReference"
				},
				"typeProperties": {
					"scripts": [
						{
							"type": "Query",
							"text": {
								"value": "UPDATE ctrl.audit_log SET STATUS='SUCCESS', end_time=SYSUTCDATETIME(), records_written=@{activity('Bronze to Silver').output.runOutput}\nWHERE adf_run_id='@{pipeline().parameters.adf_run_id}' AND table_id=@{pipeline().parameters.table_id}",
								"type": "Expression"
							}
						}
					],
					"scriptBlockExecutionTimeout": "02:00:00"
				}
			},
			{
				"name": "Check Load Type",
				"type": "IfCondition",
				"dependsOn": [
					{
						"activity": "Read Tables Details",
						"dependencyConditions": [
							"Succeeded"
						]
					},
					{
						"activity": "Set Start Time",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"expression": {
						"value": "@not(equals(activity('Read Tables Details').output.firstRow.load_type,'FULL'))",
						"type": "Expression"
					},
					"ifTrueActivities": [
						{
							"name": "Store Watermark Value",
							"type": "SetVariable",
							"dependsOn": [
								{
									"activity": "Read Watermark",
									"dependencyConditions": [
										"Succeeded"
									]
								}
							],
							"policy": {
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"variableName": "Watermark Value",
								"value": {
									"value": "@activity('Read Watermark').output.firstRow.watermark_value",
									"type": "Expression"
								}
							}
						},
						{
							"name": "Read Watermark",
							"type": "Lookup",
							"dependsOn": [],
							"policy": {
								"timeout": "0.12:00:00",
								"retry": 0,
								"retryIntervalInSeconds": 30,
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"source": {
									"type": "AzureSqlSource",
									"sqlReaderQuery": {
										"value": "SELECT watermark_value from ctrl.watermark where table_id=@{pipeline().parameters.table_id}",
										"type": "Expression"
									},
									"queryTimeout": "02:00:00",
									"partitionOption": "None"
								},
								"dataset": {
									"referenceName": "AzureSqlTable1",
									"type": "DatasetReference"
								}
							}
						}
					]
				}
			},
			{
				"name": "Check load type and update watermark",
				"type": "IfCondition",
				"dependsOn": [
					{
						"activity": "Bronze to Silver",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"expression": {
						"value": "@not(equals(activity('Read Tables Details').output.firstRow.load_type,'FULL'))",
						"type": "Expression"
					},
					"ifTrueActivities": [
						{
							"name": "update watermark",
							"type": "Script",
							"dependsOn": [],
							"policy": {
								"timeout": "0.12:00:00",
								"retry": 0,
								"retryIntervalInSeconds": 30,
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"linkedServiceName": {
								"referenceName": "LS_AzureSqlDatabase",
								"type": "LinkedServiceReference"
							},
							"typeProperties": {
								"scripts": [
									{
										"type": "Query",
										"text": {
											"value": "UPDATE ctrl.watermark \nSET watermark_value=SYSUTCDATETIME()\nWHERE table_id=@{pipeline().parameters.table_id}",
											"type": "Expression"
										}
									}
								],
								"scriptBlockExecutionTimeout": "02:00:00"
							}
						}
					]
				}
			},
			{
				"name": "Check Source System",
				"type": "Switch",
				"dependsOn": [
					{
						"activity": "Check Load Type",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"on": {
						"value": "@activity('Read Tables Details').output.firstRow.source_system",
						"type": "Expression"
					},
					"cases": [
						{
							"value": "neon_postgres",
							"activities": [
								{
									"name": "SOURCE_TO_LANDING Ingestion",
									"type": "Copy",
									"dependsOn": [],
									"policy": {
										"timeout": "0.12:00:00",
										"retry": 0,
										"retryIntervalInSeconds": 30,
										"secureOutput": false,
										"secureInput": false
									},
									"userProperties": [],
									"typeProperties": {
										"source": {
											"type": "PostgreSqlV2Source",
											"query": {
												"value": "SELECT * FROM PUBLIC.@{activity('Read Tables Details').output.firstRow.source_table_name}\n@{\n    if(equals(activity('Read Tables Details').output.firstRow.load_type,'FULL'),\n        '',\n        concat(\n            'where ', activity('Read Tables Details').output.firstRow.watermark_column ,'>','''',variables('Watermark Value'),''''\n        )\n    )\n}",
												"type": "Expression"
											},
											"queryTimeout": "02:00:00"
										},
										"sink": {
											"type": "ParquetSink",
											"storeSettings": {
												"type": "AzureBlobFSWriteSettings"
											},
											"formatSettings": {
												"type": "ParquetWriteSettings"
											}
										},
										"enableStaging": false,
										"translator": {
											"type": "TabularTranslator",
											"typeConversion": true,
											"typeConversionSettings": {
												"allowDataTruncation": true,
												"treatBooleanAsNumber": false
											}
										}
									},
									"inputs": [
										{
											"referenceName": "DS_PostgreSqlTable",
											"type": "DatasetReference"
										}
									],
									"outputs": [
										{
											"referenceName": "ADLS_DS_Parquet",
											"type": "DatasetReference",
											"parameters": {
												"container": "landing",
												"folder": {
													"value": "@concat(\n    activity('Read Tables Details').output.firstRow.source_system,'/',activity('Read Tables Details').output.firstRow.source_table_name,'/',variables('start time')\n)",
													"type": "Expression"
												}
											}
										}
									]
								}
							]
						},
						{
							"value": "adls_csv",
							"activities": [
								{
									"name": "Ingest csv from Source to Landing",
									"type": "Copy",
									"dependsOn": [],
									"policy": {
										"timeout": "0.12:00:00",
										"retry": 0,
										"retryIntervalInSeconds": 30,
										"secureOutput": false,
										"secureInput": false
									},
									"userProperties": [],
									"typeProperties": {
										"source": {
											"type": "BinarySource",
											"storeSettings": {
												"type": "AzureBlobFSReadSettings",
												"recursive": false,
												"modifiedDatetimeStart": {
													"value": "@variables('Watermark Value')",
													"type": "Expression"
												},
												"deleteFilesAfterCompletion": false
											},
											"formatSettings": {
												"type": "BinaryReadSettings"
											}
										},
										"sink": {
											"type": "BinarySink",
											"storeSettings": {
												"type": "AzureBlobFSWriteSettings"
											}
										},
										"enableStaging": false
									},
									"inputs": [
										{
											"referenceName": "DS_csv_binary",
											"type": "DatasetReference",
											"parameters": {
												"folder": {
													"value": "@activity('Read Tables Details').output.firstRow.source_path",
													"type": "Expression"
												},
												"container": "source"
											}
										}
									],
									"outputs": [
										{
											"referenceName": "DS_csv_binary",
											"type": "DatasetReference",
											"parameters": {
												"folder": {
													"value": "@concat(\n    activity('Read Tables Details').output.firstRow.source_system,'/',activity('Read Tables Details').output.firstRow.source_table_name,'/',variables('start time')\n)",
													"type": "Expression"
												},
												"container": "landing"
											}
										}
									]
								}
							]
						}
					]
				}
			}
		],
		"parameters": {
			"table_id": {
				"type": "string",
				"defaultValue": "1"
			},
			"adf_run_id": {
				"type": "string",
				"defaultValue": "a1"
			}
		},
		"variables": {
			"start time": {
				"type": "String"
			},
			"Watermark Value": {
				"type": "String"
			}
		},
		"annotations": []
	}
}